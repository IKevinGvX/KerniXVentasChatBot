    <UserSecretsId>805332d4-ea76-4ee3-aeb1-c54cf29dfc8b</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\images\banners\**" />
    <Compile Remove="wwwroot\images\Brand\**" />
