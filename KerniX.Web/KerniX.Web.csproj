    <Content Remove="wwwroot\images\Brand\**" />
    <Content Remove="wwwroot\images\hero\**" />
    <EmbeddedResource Remove="wwwroot\images\banners\**" />
    <EmbeddedResource Remove="wwwroot\images\Brand\**" />
    <EmbeddedResource Remove="wwwroot\images\hero\**" />
