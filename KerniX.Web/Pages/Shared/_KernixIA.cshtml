<section id="kernix-ia"
         class="kx-section kx-ai-section">

    <div class="uk-container">

        <div class="uk-grid-large uk-flex-middle"
             uk-grid>

            <div class="uk-width-1-2@@m">

                <span class="kx-section-tag">
                    INTELIGENCIA ARTIFICIAL
                </span>

                <h2 class="kx-content-title">

                    Conoce a

                    <span>
                        KerniX IA
                    </span>

                </h2>

                <p class="kx-content-text">

                    Un asistente comercial conectado con tu empresa
                    para responder consultas, recomendar productos
                    y ayudar al cliente durante su compra.

                </p>


                <div class="kx-ai-capabilities">

                    <div>
                        <span uk-icon="search"></span>
                        Consultar productos
                    </div>

                    <div>
                        <span uk-icon="database"></span>
                        Consultar disponibilidad
                    </div>

                    <div>
                        <span uk-icon="file-edit"></span>
                        Preparar cotizaciones
                    </div>

                    <div>
                        <span uk-icon="cart"></span>
                        Ayudar con pedidos
                    </div>

                    <div>
                        <span uk-icon="tag"></span>
                        Mostrar promociones
                    </div>

                    <div>
                        <span uk-icon="receiver"></span>
                        Derivar a un vendedor
                    </div>

                </div>


                <button type="button"
                        onclick="openKernixChat()"
                        class="kx-btn kx-btn-primary">

                    <span uk-icon="comment"></span>

                    Probar KerniX IA

                </button>

            </div>


            <div class="uk-width-1-2@@m">

                <div class="kx-media-frame kx-ai-image">

                    <img src="~/images/kernix_ia_automatizacion.webp"
                         alt="KerniX Inteligencia Artificial" />

                </div>

            </div>

        </div>

    </div>

</section>