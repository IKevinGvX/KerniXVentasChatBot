<section id="promociones" class="kx-section kxp-promotions">

    <!-- Fondo -->
    <div class="kxp-grid-bg"></div>
    <div class="kxp-orb kxp-orb-blue"></div>
    <div class="kxp-orb kxp-orb-gold"></div>

    <div class="uk-container">

        <!-- CABECERA -->
        <div class="kxp-heading">

            <div>
                <span class="kxp-eyebrow">
                    <i></i>
                    OPORTUNIDADES
                </span>

                <h2>
                    Tecnología para impulsar
                    <strong>tu empresa</strong>
                </h2>
            </div>

            <p>
                Encuentra productos, soluciones y oportunidades
                tecnológicas pensadas para hacer crecer tu negocio.
            </p>

        </div>


        <!-- =========================================
             ESCENARIO PRINCIPAL 3D
        ========================================== -->
        <div class="kxp-stage">

            <!-- IMAGEN -->
            <div class="kxp-visual">

                <img src="~/images/kernix_banner_promociones.webp"
                     alt="Productos y oportunidades KerniX"
                     class="kxp-image" />

                <div class="kxp-image-overlay"></div>
                <div class="kxp-shine"></div>

                <!-- Badge -->
                <div class="kxp-badge">

                    <span class="kxp-badge-dot"></span>

                    <div>
                        <small>KERNIX BUSINESS</small>
                        <strong>Catálogo empresarial</strong>
                    </div>

                </div>


                <!-- DISPONIBILIDAD -->
                <div class="kxp-stock">

                    <div class="kxp-stock-icon">
                        <span uk-icon="check"></span>
                    </div>

                    <div>
                        <small>DISPONIBILIDAD</small>
                        <strong>Productos disponibles</strong>
                    </div>

                </div>


                <!-- CONTENIDO PRINCIPAL -->
                <div class="kxp-main-content">

                    <span class="kxp-small-label">
                        TECNOLOGÍA PARA EMPRESAS
                    </span>

                    <h3>
                        Encuentra lo que
                        <span>tu negocio necesita</span>
                    </h3>

                    <p>
                        Equipamiento, accesorios, conectividad y
                        soluciones para potenciar tu operación.
                    </p>

                    <a asp-page="/Productos/Index"
                       class="kxp-primary-button">

                        Explorar productos

                        <span uk-icon="arrow-right"></span>

                    </a>

                </div>

            </div>


            <!-- =========================================
                 CATEGORÍAS FLOTANTES
            ========================================== -->

            <div class="kxp-category kxp-category-one">

                <div class="kxp-category-icon">
                    <span uk-icon="desktop"></span>
                </div>

                <div>
                    <small>CATEGORÍA</small>
                    <strong>Tecnología</strong>
                    <span>Equipos y dispositivos</span>
                </div>

                <span class="kxp-category-arrow"
                      uk-icon="chevron-right"></span>

            </div>


            <div class="kxp-category kxp-category-two">

                <div class="kxp-category-icon kxp-blue-icon">
                    <span uk-icon="wifi"></span>
                </div>

                <div>
                    <small>CATEGORÍA</small>
                    <strong>Conectividad</strong>
                    <span>Redes y comunicación</span>
                </div>

                <span class="kxp-category-arrow"
                      uk-icon="chevron-right"></span>

            </div>


            <div class="kxp-category kxp-category-three">

                <div class="kxp-category-icon">
                    <span uk-icon="cog"></span>
                </div>

                <div>
                    <small>CATEGORÍA</small>
                    <strong>Soluciones</strong>
                    <span>Herramientas empresariales</span>
                </div>

                <span class="kxp-category-arrow"
                      uk-icon="chevron-right"></span>

            </div>

        </div>


        <!-- =========================================
             BENEFICIOS
        ========================================== -->

        <div class="kxp-benefits">

            <article>

                <div class="kxp-benefit-icon">
                    <span uk-icon="search"></span>
                </div>

                <div>
                    <strong>Encuentra productos</strong>
                    <span>
                        Explora diferentes categorías
                    </span>
                </div>

            </article>


            <article>

                <div class="kxp-benefit-icon">
                    <span uk-icon="database"></span>
                </div>

                <div>
                    <strong>Consulta disponibilidad</strong>
                    <span>
                        Información centralizada
                    </span>
                </div>

            </article>


            <article>

                <div class="kxp-benefit-icon">
                    <span uk-icon="file-text"></span>
                </div>

                <div>
                    <strong>Solicita cotización</strong>
                    <span>
                        Atención para tu empresa
                    </span>
                </div>

            </article>


            <article>

                <div class="kxp-benefit-icon">
                    <span uk-icon="receiver"></span>
                </div>

                <div>
                    <strong>Habla con un vendedor</strong>
                    <span>
                        Asesoría personalizada
                    </span>
                </div>

            </article>

        </div>

    </div>

</section>