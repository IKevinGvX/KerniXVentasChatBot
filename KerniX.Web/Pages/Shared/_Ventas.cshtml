<section id="ventas" class="kx-section kxv-sales">

    <!-- Fondo decorativo -->
    <div class="kxv-grid-bg"></div>
    <div class="kxv-orb kxv-orb-blue"></div>
    <div class="kxv-orb kxv-orb-gold"></div>

    <div class="uk-container">

        <div class="kxv-layout">

            <!-- =================================================
                 CONTENIDO / PIPELINE
            ================================================== -->
            <div class="kxv-content">

                <div class="kxv-eyebrow">
                    <span></span>
                    CRECIMIENTO INTELIGENTE
                </div>

                <h2 class="kxv-title">
                    Convierte oportunidades
                    <strong>en ventas</strong>
                </h2>

                <p class="kxv-description">
                    KerniX conecta clientes, inteligencia artificial,
                    cotizaciones y vendedores en un flujo comercial
                    diseñado para responder más rápido y generar
                    nuevas oportunidades.
                </p>

                <!-- Pipeline -->
                <div class="kxv-pipeline">

                    <!-- Línea animada -->
                    <div class="kxv-pipeline-line">
                        <span></span>
                    </div>

                    <!-- 01 -->
                    <article class="kxv-step">

                        <div class="kxv-step-number">
                            01
                        </div>

                        <div class="kxv-step-icon">
                            <span uk-icon="comments"></span>
                        </div>

                        <div class="kxv-step-text">
                            <small>ENTRADA</small>
                            <strong>Cliente consulta</strong>
                            <p>
                                El cliente encuentra productos
                                y solicita información.
                            </p>
                        </div>

                        <span class="kxv-step-status"></span>

                    </article>

                    <!-- 02 -->
                    <article class="kxv-step">

                        <div class="kxv-step-number">
                            02
                        </div>

                        <div class="kxv-step-icon kxv-step-icon-ai">
                            <span uk-icon="bolt"></span>
                        </div>

                        <div class="kxv-step-text">
                            <small>INTELIGENCIA ARTIFICIAL</small>
                            <strong>KerniX IA asesora</strong>
                            <p>
                                Analiza la consulta y ayuda
                                a encontrar la mejor opción.
                            </p>
                        </div>

                        <span class="kxv-step-status"></span>

                    </article>

                    <!-- 03 -->
                    <article class="kxv-step">

                        <div class="kxv-step-number">
                            03
                        </div>

                        <div class="kxv-step-icon">
                            <span uk-icon="file-text"></span>
                        </div>

                        <div class="kxv-step-text">
                            <small>AUTOMATIZACIÓN</small>
                            <strong>Genera cotización</strong>
                            <p>
                                Productos, cantidades y precios
                                quedan listos para continuar.
                            </p>
                        </div>

                        <span class="kxv-step-status"></span>

                    </article>

                    <!-- 04 -->
                    <article class="kxv-step">

                        <div class="kxv-step-number">
                            04
                        </div>

                        <div class="kxv-step-icon">
                            <span uk-icon="receiver"></span>
                        </div>

                        <div class="kxv-step-text">
                            <small>OPORTUNIDAD</small>
                            <strong>Vendedor recibe el lead</strong>
                            <p>
                                El equipo comercial continúa
                                la oportunidad con contexto.
                            </p>
                        </div>

                        <span class="kxv-step-status"></span>

                    </article>

                </div>

            </div>


            <!-- =================================================
                 DASHBOARD 3D
            ================================================== -->
            <div class="kxv-visual">

                <div class="kxv-dashboard">

                    <!-- Brillo -->
                    <div class="kxv-dashboard-shine"></div>

                    <!-- HEADER -->
                    <div class="kxv-dashboard-header">

                        <div>

                            <div class="kxv-dashboard-label">
                                KERNIX SALES
                            </div>

                            <strong>
                                Rendimiento comercial
                            </strong>

                        </div>

                        <div class="kxv-live">
                            <span></span>
                            En vivo
                        </div>

                    </div>


                    <!-- KPI PRINCIPAL -->
                    <div class="kxv-main-kpi">

                        <div>

                            <small>
                                CRECIMIENTO DE VENTAS
                            </small>

                            <strong>
                                +32.8%
                            </strong>

                            <span>
                                ↗ +8.4% este mes
                            </span>

                        </div>

                        <div class="kxv-kpi-badge">
                            <span uk-icon="trending-up"></span>
                        </div>

                    </div>


                    <!-- =================================================
                         GRÁFICA
                    ================================================== -->
                    <div class="kxv-chart">

                        <div class="kxv-chart-lines">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                        <div class="kxv-chart-bars">

                            <i style="--kxv-height: 30%; --kxv-delay: .1s;"></i>

                            <i style="--kxv-height: 43%; --kxv-delay: .2s;"></i>

                            <i style="--kxv-height: 38%; --kxv-delay: .3s;"></i>

                            <i style="--kxv-height: 58%; --kxv-delay: .4s;"></i>

                            <i style="--kxv-height: 53%; --kxv-delay: .5s;"></i>

                            <i style="--kxv-height: 72%; --kxv-delay: .6s;"></i>

                            <i style="--kxv-height: 68%; --kxv-delay: .7s;"></i>

                            <i style="--kxv-height: 91%; --kxv-delay: .8s;"></i>

                        </div>

                        <!-- Línea de tendencia -->
                        <svg class="kxv-chart-line"
                             viewBox="0 0 500 160"
                             preserveAspectRatio="none"
                             aria-hidden="true">

                            <defs>

                                <linearGradient id="kxvSalesGradient"
                                                x1="0"
                                                x2="1">

                                    <stop offset="0%"
                                          stop-color="#00d9ff" />

                                    <stop offset="100%"
                                          stop-color="#ffc21c" />

                                </linearGradient>

                            </defs>

                            <polyline points="
                            5,135
                            70,120
                            135,125
                            200,92
                            265,100
                            330,66
                            395,73
                            490,25"
                                      fill="none"
                                      stroke="url(#kxvSalesGradient)"
                                      stroke-width="4"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />

                        </svg>

                    </div>


                    <!-- =================================================
                         MINI KPIs
                    ================================================== -->
                    <div class="kxv-kpis">

                        <article>

                            <div class="kxv-mini-icon">
                                <span uk-icon="users"></span>
                            </div>

                            <div>
                                <small>LEADS</small>
                                <strong>248</strong>
                                <span>+18%</span>
                            </div>

                        </article>


                        <article>

                            <div class="kxv-mini-icon">
                                <span uk-icon="file-text"></span>
                            </div>

                            <div>
                                <small>COTIZACIONES</small>
                                <strong>86</strong>
                                <span>+12%</span>
                            </div>

                        </article>


                        <article>

                            <div class="kxv-mini-icon">
                                <span uk-icon="check"></span>
                            </div>

                            <div>
                                <small>CONVERSIÓN</small>
                                <strong>34.7%</strong>
                                <span>+5.2%</span>
                            </div>

                        </article>

                    </div>


                    <!-- FOOTER DASHBOARD -->
                    <div class="kxv-dashboard-footer">

                        <div>
                            <span class="kxv-footer-dot"></span>

                            <div>
                                <small>IA COMERCIAL</small>
                                <strong>
                                    Analizando oportunidades
                                </strong>
                            </div>
                        </div>

                        <span uk-icon="bolt"></span>

                    </div>

                </div>


                <!-- =================================================
                     OPORTUNIDAD FLOTANTE
                ================================================== -->
                <div class="kxv-opportunity">

                    <div class="kxv-opportunity-icon">
                        <span uk-icon="cart"></span>
                    </div>

                    <div>
                        <small>ACTIVIDAD COMERCIAL</small>

                        <strong>
                            Nueva solicitud de productos
                        </strong>

                        <span>
                            Productos • Stock • Cotización
                        </span>
                    </div>

                    <div class="kxv-opportunity-status">
                        <span></span>
                        ACTIVA
                    </div>

                </div>

                <!-- =================================================
                     IA FLOTANTE
                ================================================== -->
                <div class="kxv-ai-chip">

                    <div class="kxv-ai-logo">
                        K
                    </div>

                    <div>
                        <small>KerniX IA</small>
                        <strong>
                            Lead calificado
                        </strong>
                    </div>

                    <span></span>

                </div>

            </div>

        </div>

    </div>

</section>