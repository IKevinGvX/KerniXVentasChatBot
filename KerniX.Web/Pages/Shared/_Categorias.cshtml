<section id="productos"
         class="kx-section">

    <div class="uk-container">

        <div class="kx-section-header">

            <span class="kx-section-tag">
                TECNOLOGÍA EMPRESARIAL
            </span>

            <h2>
                Todo lo que tu empresa
                <span>necesita</span>
            </h2>

            <p>
                Encuentra tecnología, equipamiento y soluciones
                para hacer crecer tu negocio.
            </p>

        </div>


        <div class="uk-grid-medium
            uk-child-width-1-2@@s
            uk-child-width-1-3@@l"
             uk-grid>


            <!-- OFICINA -->

            <div>

                <article class="kx-category-card">

                    <div class="kx-category-image">

                        <img src="~/images/kernix_categoria_oficina.webp"
                             alt="Equipos de oficina" />

                        <div class="kx-category-overlay"></div>

                    </div>

                    <div class="kx-category-content">

                        <span uk-icon="desktop"></span>

                        <h3>
                            Equipos de oficina
                        </h3>

                        <p>
                            Tecnología para mejorar la productividad
                            de tu equipo.
                        </p>

                        <a asp-page="/Productos/Index">
                            Explorar
                            <span uk-icon="arrow-right"></span>
                        </a>

                    </div>

                </article>

            </div>


            <!-- REDES -->

            <div>

                <article class="kx-category-card">

                    <div class="kx-category-image">

                        <img src="~/images/kernix_categoria_redes.webp"
                             alt="Redes y seguridad" />

                        <div class="kx-category-overlay"></div>

                    </div>

                    <div class="kx-category-content">

                        <span uk-icon="world"></span>

                        <h3>
                            Redes y seguridad
                        </h3>

                        <p>
                            Conectividad, infraestructura y seguridad
                            para tu empresa.
                        </p>

                        <a asp-page="/Productos/Index">
                            Explorar
                            <span uk-icon="arrow-right"></span>
                        </a>

                    </div>

                </article>

            </div>


            <!-- ACCESORIOS -->

            <div>

                <article class="kx-category-card">

                    <div class="kx-category-image">

                        <img src="~/images/kernix_categoria_accesorios.webp"
                             alt="Accesorios tecnológicos" />

                        <div class="kx-category-overlay"></div>

                    </div>

                    <div class="kx-category-content">

                        <span uk-icon="settings"></span>

                        <h3>
                            Accesorios
                        </h3>

                        <p>
                            Periféricos y accesorios profesionales
                            para tu espacio de trabajo.
                        </p>

                        <a asp-page="/Productos/Index">
                            Explorar
                            <span uk-icon="arrow-right"></span>
                        </a>

                    </div>

                </article>

            </div>

        </div>

    </div>

</section>