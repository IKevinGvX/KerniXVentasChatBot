<section id="soluciones" class="kx-section kxs-solutions">

    <!-- Decoración ambiental -->
    <div class="kxs-bg-grid"></div>
    <div class="kxs-orb kxs-orb-blue"></div>
    <div class="kxs-orb kxs-orb-gold"></div>

    <div class="uk-container">

        <div class="kxs-layout">

            <!-- ==========================================
                 PANEL VISUAL IZQUIERDO
            =========================================== -->
            <div class="kxs-visual">

                <div class="kxs-image-card">

                    <img src="~/images/kernix_soluciones_empresariales.webp"
                         alt="Soluciones empresariales KerniX"
                         class="kxs-main-image" />

                    <div class="kxs-image-overlay"></div>
                    <div class="kxs-image-shine"></div>

                    <!-- Estado -->
                    <div class="kxs-live-card">

                        <span class="kxs-live-dot"></span>

                        <div>
                            <small>ECOSISTEMA KERNIX</small>
                            <strong>Todo conectado</strong>
                        </div>

                    </div>

                    <!-- Eficiencia -->
                    <div class="kxs-stat-card">

                        <div class="kxs-stat-icon">
                            <span uk-icon="bolt"></span>
                        </div>

                        <div>
                            <strong>+40%</strong>
                            <small>Eficiencia operativa</small>
                        </div>

                    </div>

                    <!-- Datos -->
                    <div class="kxs-data-card">

                        <div class="kxs-data-header">
                            <span>OPERACIÓN</span>
                            <strong>EN VIVO</strong>
                        </div>

                        <div class="kxs-data-bars">
                            <i></i>
                            <i></i>
                            <i></i>
                            <i></i>
                            <i></i>
                        </div>

                    </div>

                </div>

                <!-- PANEL EMPRESARIAL FLOTANTE -->
                <div class="kxs-company-panel">

                    <!-- SOBRE LA EMPRESA -->
                    <a asp-page="/Nosotros/Index"
                       class="kxs-company-option">

                        <div class="kxs-company-icon">
                            <span uk-icon="home"></span>
                        </div>

                        <div class="kxs-company-info">
                            <small>KERNIX S.A.C.</small>
                            <strong>Sobre la empresa</strong>
                            <span>Conoce quiénes somos</span>
                        </div>

                        <div class="kxs-company-arrow">
                            <span uk-icon="chevron-right"></span>
                        </div>

                    </a>


                    <div class="kxs-company-divider"></div>


                    <!-- INVENTARIO -->
                    <a asp-page="/Productos/Index"
                       class="kxs-company-option">

                        <div class="kxs-company-icon kxs-company-icon-blue">
                            <span uk-icon="database"></span>
                        </div>

                        <div class="kxs-company-info">
                            <small>PRODUCTOS</small>
                            <strong>Inventario</strong>
                            <span>Productos y disponibilidad</span>
                        </div>

                        <div class="kxs-company-status">
                            <i></i>
                            ACTIVO
                        </div>

                    </a>

                </div>
            </div>


            <!-- ==========================================
                 CONTENIDO DERECHO
            =========================================== -->
            <div class="kxs-content">

                <div class="kxs-eyebrow">
                    <span></span>
                    TODO CONECTADO
                </div>

                <h2>
                    Controla tu empresa
                    <strong>desde un solo lugar</strong>
                </h2>

                <p class="kxs-description">
                    KerniX conecta las principales áreas de tu negocio
                    para centralizar la información, automatizar procesos
                    y ayudarte a tomar decisiones más rápidas.
                </p>


                <!-- ======================================
                     FUNCIONES
                ======================================= -->
                <div class="kxs-features">

                    <article class="kxs-feature">

                        <div class="kxs-feature-icon">
                            <span uk-icon="cart"></span>
                        </div>

                        <div class="kxs-feature-text">
                            <strong>Ventas</strong>
                            <small>Pedidos y cotizaciones</small>
                        </div>

                        <span class="kxs-arrow"
                              uk-icon="chevron-right"></span>

                    </article>


                    <article class="kxs-feature">

                        <div class="kxs-feature-icon">
                            <span uk-icon="database"></span>
                        </div>

                        <div class="kxs-feature-text">
                            <strong>Inventario</strong>
                            <small>Stock actualizado</small>
                        </div>

                        <span class="kxs-arrow"
                              uk-icon="chevron-right"></span>

                    </article>


                    <article class="kxs-feature">

                        <div class="kxs-feature-icon">
                            <span uk-icon="users"></span>
                        </div>

                        <div class="kxs-feature-text">
                            <strong>Clientes</strong>
                            <small>Información centralizada</small>
                        </div>

                        <span class="kxs-arrow"
                              uk-icon="chevron-right"></span>

                    </article>


                    <article class="kxs-feature">

                        <div class="kxs-feature-icon">
                            <span uk-icon="file-text"></span>
                        </div>

                        <div class="kxs-feature-text">
                            <strong>Gestión</strong>
                            <small>Procesos empresariales</small>
                        </div>

                        <span class="kxs-arrow"
                              uk-icon="chevron-right"></span>

                    </article>

                </div>


                <!-- ======================================
                     STATUS
                ======================================= -->
                <div class="kxs-status">

                    <div class="kxs-status-left">

                        <span class="kxs-status-dot"></span>

                        <div>
                            <small>PLATAFORMA ACTIVA</small>
                            <strong>
                                KerniX conectando tu negocio
                            </strong>
                        </div>

                    </div>

                    <div class="kxs-status-icon">
                        <span uk-icon="arrow-right"></span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>