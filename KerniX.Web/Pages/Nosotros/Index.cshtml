                </span>

            </a>


            <!-- IA -->

            <button type="button"
                    id="kxabout-open-ai"
                    class="kxabout-service">

                <div class="kxabout-service-number">
                    03
                </div>

                <div class="kxabout-service-icon">
                    <span uk-icon="bolt"></span>
                </div>

                <small>
                    KERNIX INTELLIGENCE
                </small>

                <h3>
                    Inteligencia artificial
