                    </div>

                    <div>
                        <span uk-icon="check"></span>
                        Búsqueda de productos
                    </div>

                    <div>
                        <span uk-icon="check"></span>
                        Asistencia comercial
                    </div>

                    <div>
                        <span uk-icon="check"></span>
                        Atención inteligente
                    </div>

                </div>


                <button type="button"
                        id="kxabout-ai-button"
                        class="kxabout-ai-button">

                    <span uk-icon="bolt"></span>

                    Probar KerniX IA

                    <span uk-icon="arrow-right"></span>

                </button>

            </div>

        </div>


        <!-- =====================================================
             CONTACTO
        ====================================================== -->

        <div id="kxabout-contact"
             class="kxabout-contact">

            <div>

                <div class="kxabout-eyebrow">
                    <span></span>
                    KERNIX BUSINESS
                </div>

                <h2>
                    ¿Tu empresa necesita
                    <strong>tecnología?</strong>
                </h2>

                <p>
                    Nuestro equipo puede ayudarte a encontrar
                    productos y soluciones para tu negocio.
                </p>

            </div>


            <div class="kxabout-contact-actions">

                <a href="https://wa.me/51930338447?text=Hola%20KerniX%2C%20deseo%20informaci%C3%B3n%20sobre%20sus%20productos%20y%20soluciones."
                   target="_blank"
                   rel="noopener noreferrer"
                   class="kxabout-contact-primary">

                    <span uk-icon="receiver"></span>

                    Hablar con un asesor

                </a>


                <a asp-page="/Productos/Index"
                   class="kxabout-contact-secondary">

                    Ver productos

                    <span uk-icon="arrow-right"></span>

                </a>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const aiButtons = [
                document.getElementById("kxabout-open-ai"),
                document.getElementById("kxabout-ai-button")
            ];


            function openKernixAI() {

                /*
                 * Usamos la función global que ya tiene
                 * nuestro chatbot KerniX.
                 */

                if (typeof openKernixChat === "function") {

                    openKernixChat();

                    return;

                }


                /*
                 * Fallback:
                 * si openKernixChat todavía no está disponible,
                 * usamos directamente la ventana.
                 */

                const chat =
                    document.getElementById(
                        "kernix-chat-window"
                    );


                if (chat) {

                    chat.classList.add("open");

                }

            }


            aiButtons.forEach(button => {

                button?.addEventListener(
                    "click",
                    openKernixAI
                );

            });

        });

    </script>

}