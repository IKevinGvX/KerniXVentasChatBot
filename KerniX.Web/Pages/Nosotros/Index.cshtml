@page
@model KerniX.Web.Pages.Nosotros.IndexModel

@{
    ViewData["Title"] = "Nosotros | KerniX";
}

<section class="kxabout">

    <div class="kxabout-grid"></div>
    <div class="kxabout-orb kxabout-orb-blue"></div>
    <div class="kxabout-orb kxabout-orb-gold"></div>

    <div class="uk-container">

        <!-- =====================================================
             HERO
        ====================================================== -->

        <div class="kxabout-hero">

            <div class="kxabout-copy">

                <div class="kxabout-eyebrow">
                    <span></span>
                    KERNIX S.A.C.
                </div>

                <h1>
                    Tecnología que conecta
                    <strong>empresas con el futuro.</strong>
                </h1>

                <p>
                    En KerniX desarrollamos soluciones tecnológicas
                    orientadas a mejorar la gestión, productividad y
                    crecimiento de las empresas.
                </p>

                <div class="kxabout-actions">

                    <a asp-page="/Productos/Index"
                       class="kxabout-primary">

                        <span uk-icon="grid"></span>

                        Explorar productos

                        <span uk-icon="arrow-right"></span>

                    </a>

                    <a href="#kxabout-contact"
                       class="kxabout-secondary">

                        <span uk-icon="receiver"></span>

                        Contactar

                    </a>

                </div>

            </div>


            <!-- PANEL 3D -->

            <div class="kxabout-command">

                <div class="kxabout-command-top">

                    <div>
                        <small>KERNIX BUSINESS</small>
                        <strong>Centro tecnológico</strong>
                    </div>

                    <div class="kxabout-live">
                        <i></i>
                        ACTIVO
                    </div>

                </div>


                <div class="kxabout-core">

                    <div class="kxabout-core-ring ring-one"></div>
                    <div class="kxabout-core-ring ring-two"></div>
                    <div class="kxabout-core-ring ring-three"></div>

                    <div class="kxabout-core-center">

