            </p>

        </div>


        <div class="kxabout-ecosystem">

            <!-- PRODUCTOS -->

            <a asp-page="/Productos/Index"
               class="kxabout-service">

                <div class="kxabout-service-number">
                    01
                </div>

                <div class="kxabout-service-icon">
                    <span uk-icon="desktop"></span>
                </div>

                <small>
                    KERNIX PRODUCTS
                </small>

                <h3>
                    Tecnología y productos
                </h3>

                <p>
                    Equipamiento, accesorios, conectividad
