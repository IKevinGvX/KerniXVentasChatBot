        ====================================================== -->

        <div class="kxdetail-related-header">

            <div>

                <small>
                    TAMBIÉN TE PUEDE INTERESAR
                </small>

                <h2>
                    Productos relacionados
                </h2>

            </div>


            <a asp-page="/Productos/Index">

                Ver catálogo

