            </a>

        </div>


        <div class="kxdetail-related">

            <a asp-page="/Productos/Detalle"
               asp-route-id="2"
               class="kxdetail-related-card">

                <div class="kxdetail-related-image">

                    <img src="~/images/kernix_categoria_oficina.webp"
                         alt="Monitor profesional" />

                </div>

                <div>

                    <small>CÓMPUTO</small>

                    <strong>
                        Monitor profesional
                    </strong>

                    <span>
                        Ver producto
                        <i uk-icon="arrow-right"></i>
                    </span>

                </div>

            </a>


            <a asp-page="/Productos/Detalle"
               asp-route-id="3"
               class="kxdetail-related-card">

                <div class="kxdetail-related-image">

                    <img src="~/images/kernix_categoria_accesorios.webp"
                         alt="Accesorios empresariales" />

                </div>

                <div>

                    <small>ACCESORIOS</small>

                    <strong>
                        Kit teclado y mouse
                    </strong>

                    <span>
                        Ver producto
                        <i uk-icon="arrow-right"></i>
                    </span>

                </div>

            </a>


            <a asp-page="/Productos/Detalle"
               asp-route-id="4"
               class="kxdetail-related-card">

                <div class="kxdetail-related-image">

                    <img src="~/images/kernix_categoria_redes.webp"
                         alt="Router empresarial" />

                </div>

                <div>

                    <small>REDES</small>

                    <strong>
                        Router empresarial
                    </strong>

                    <span>
                        Ver producto
                        <i uk-icon="arrow-right"></i>
                    </span>

                </div>

            </a>

        </div>

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const quantityInput =
                document.getElementById("kxdetail-quantity");

            const minus =
                document.getElementById("kxdetail-minus");

            const plus =
                document.getElementById("kxdetail-plus");

            const quote =
                document.getElementById("kxdetail-quote");

            const whatsapp =
                document.getElementById("kxdetail-whatsapp");


            const productName =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nombre));

            const productCode =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(codigo));


            function getQuantity() {

                let value =
                    parseInt(quantityInput.value) || 1;

                value =
                    Math.max(
                        1,
                        Math.min(99, value)
                    );

                quantityInput.value = value;

                return value;
            }


            minus?.addEventListener("click", function () {

                const current =
                    getQuantity();

                quantityInput.value =
                    Math.max(1, current - 1);

            });


            plus?.addEventListener("click", function () {

                const current =
                    getQuantity();

                quantityInput.value =
                    Math.min(99, current + 1);

            });


            function openWhatsApp(number, type) {

                const quantity =
                    getQuantity();


                let message;


                if (type === "cotizacion") {

                    message =
                        `Hola KerniX, deseo solicitar una cotización.

        Producto: ${productName}
        Código: ${productCode}
        Cantidad: ${quantity}

        ¿Podrían brindarme información comercial?`;

                }
                else {

                    message =
                        `Hola KerniX, deseo consultar este producto.

        Producto: ${productName}
        Código: ${productCode}
        Cantidad: ${quantity}

        ¿Podrían ayudarme con disponibilidad e información?`;

                }


                const url =
                    `https://wa.me/${number}?text=${encodeURIComponent(message)}`;


                window.open(
                    url,
                    "_blank",
                    "noopener,noreferrer"
                );

            }

        quote?.addEventListener("click", function () {

            const quantity =
                getQuantity();

            const url =
            `/Cotizacion?producto=${encodeURIComponent(productName)}&cantidad=${quantity}`;

          window.location.href = url;

        });


            whatsapp?.addEventListener("click", function () {

                openWhatsApp(
                    "51937213913",
                    "consulta"
                );

            });

        });

    </script>

}