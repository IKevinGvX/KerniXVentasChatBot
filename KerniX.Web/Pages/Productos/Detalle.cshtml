<section class="kxdetail">

    <div class="kxdetail-grid"></div>
    <div class="kxdetail-orb kxdetail-orb-blue"></div>
    <div class="kxdetail-orb kxdetail-orb-gold"></div>

    <div class="uk-container">

        <!-- =====================================================
             NAVEGACIÓN
        ====================================================== -->

        <div class="kxdetail-navigation">

            <a asp-page="/Productos/Index"
               class="kxdetail-back">

                <span uk-icon="arrow-left"></span>

                Volver al catálogo

            </a>

            <div class="kxdetail-breadcrumb">

                <span>Productos</span>

                <i>/</i>

                <strong>@categoria</strong>

                <i>/</i>

                <span>@codigo</span>

            </div>

        </div>


        <!-- =====================================================
             PRODUCTO PRINCIPAL
        ====================================================== -->

        <div class="kxdetail-layout">

            <!-- =================================================
                 VISUAL
            ================================================== -->

            <div class="kxdetail-visual">

                <div class="kxdetail-image-card">

                    <div class="kxdetail-image-grid"></div>

                    <img src="@imagen"
                         alt="@nombre"
                         class="kxdetail-image" />

                    <div class="kxdetail-image-overlay"></div>
                    <div class="kxdetail-image-shine"></div>


                    <div class="kxdetail-category-badge">

                        <span uk-icon="bolt"></span>

                        @categoria

                    </div>


                    <div class="kxdetail-available">

                        <i></i>

                        DISPONIBLE

                    </div>


                    <div class="kxdetail-image-info">

                        <small>KERNIX BUSINESS</small>

                        <strong>
                            Tecnología empresarial
                        </strong>

                    </div>

                </div>


                <!-- MINI INFORMACIÓN -->

                <div class="kxdetail-visual-stats">

                    <article>

                        <span uk-icon="database"></span>

                        <div>
                            <small>STOCK</small>
                            <strong>Disponible</strong>
                        </div>

                    </article>


                    <article>

                        <span uk-icon="check"></span>

                        <div>
                            <small>CONDICIÓN</small>
                            <strong>Nuevo</strong>
                        </div>

                    </article>


                    <article>

                        <span uk-icon="receiver"></span>

                        <div>
                            <small>ATENCIÓN</small>
                            <strong>Empresas</strong>
                        </div>

                    </article>

                </div>

            </div>


            <!-- =================================================
                 INFORMACIÓN
            ================================================== -->

            <div class="kxdetail-content">

                <div class="kxdetail-eyebrow">

                    <span></span>

                    PRODUCTO KERNIX

                </div>


                <div class="kxdetail-code">
                    @codigo
                </div>


                <h1>
                    @nombre
                </h1>


                <p class="kxdetail-description">
                    @descripcion
                </p>


                <!-- PRECIO -->

                <div class="kxdetail-price-box">

                    <div>

                        <small>
                            PRECIO REFERENCIAL
                        </small>

                        <strong>
                            @precio
                        </strong>

                        <span>
                            Cotización empresarial disponible
                        </span>

                    </div>


                    <div class="kxdetail-price-status">

                        <i></i>

                        EN STOCK

                    </div>

                </div>


                <!-- =================================================
                     CARACTERÍSTICAS
                ================================================== -->

                <div class="kxdetail-section-title">

                    <span uk-icon="settings"></span>

                    Características principales

                </div>


                <div class="kxdetail-features">

                    @foreach (var caracteristica in caracteristicas)
                    {
                        <div>

                            <span uk-icon="check"></span>

                            @caracteristica

                        </div>
                    }

                </div>


                <!-- =================================================
                     CANTIDAD
                ================================================== -->

                <div class="kxdetail-purchase">

                    <div>

                        <small>
                            CANTIDAD
                        </small>

                        <div class="kxdetail-quantity">

                            <button type="button"
                                    id="kxdetail-minus"
                                    aria-label="Disminuir cantidad">

                                −

                            </button>

                            <input type="number"
                                   id="kxdetail-quantity"
