@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const search =
                document.getElementById("kernix-product-search");

            const clear =
                document.getElementById("kernix-clear-search");

            const products =
                Array.from(
                    document.querySelectorAll(".kxpdt-product")
                );

            const categories =
                document.querySelectorAll(".kxpdt-category");

            const count =
                document.getElementById("kernix-product-count");

            const empty =
                document.getElementById("kernix-no-products");


            let currentCategory = "todos";


            function normalizeText(value) {

                return (value || "")
                    .toLowerCase()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "");

            }


            function filterProducts() {

                const term =
                    normalizeText(search.value);


                let visible = 0;


                products.forEach(product => {

                    const name =
                        normalizeText(
                            product.dataset.name
                        );

                    const category =
                        product.dataset.category;


                    const matchesSearch =
                        name.includes(term) ||
                        normalizeText(category)
                            .includes(term);


                    const matchesCategory =
                        currentCategory === "todos" ||
                        category === currentCategory;


                    const show =
                        matchesSearch &&
                        matchesCategory;


                    product.hidden = !show;


                    if (show) {
                        visible++;
                    }

                });


                count.textContent = visible;

                empty.classList.toggle(
                    "show",
                    visible === 0
                );

            }


            categories.forEach(button => {

                button.addEventListener(
                    "click",
                    function () {

                        categories.forEach(item =>
                            item.classList.remove("active")
                        );


                        this.classList.add("active");


                        currentCategory =
                            this.dataset.category;


                        filterProducts();

                    }
                );

            });


            search.addEventListener(
                "input",
                filterProducts
            );


            clear.addEventListener(
                "click",
                function () {

                    search.value = "";

                    currentCategory = "todos";


                    categories.forEach(item =>
                        item.classList.remove("active")
                    );


                    document
                        .querySelector(
                            '[data-category="todos"]'
                        )
                        ?.classList.add("active");


                    filterProducts();

                    search.focus();

                }
            );


            filterProducts();

        });

    </script>

}